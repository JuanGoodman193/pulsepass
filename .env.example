# PulsePass — Environment Variables Template (No real secrets here)
# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/pulsepass
DB_USER=postgres
DB_PASSWORD=postgres

# Spring Security & JJWT Configuration
# Base64-encoded secret key must decode to at least 32 bytes (256 bits) for HS256
PULSEPASS_JWT_SECRET_BASE64=cGxlYXNlcHJvdmlkZWF2YWxpZGJhc2U2NHNlY3JldGtleW9mYXRsZWFzdDMyYnl0ZXM=
PULSEPASS_JWT_ISSUER=pulsepass-api
PULSEPASS_JWT_TTL=PT15M
